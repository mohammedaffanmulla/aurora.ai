# ============================================
# App
# ============================================

APP_NAME=Aurora
APP_VERSION=0.1.0
DEBUG=True

SECRET_KEY=your-super-secret-key

DATABASE_URL=postgresql+asyncpg://aurora:aurora@localhost:5432/aurora


# ============================================
# Auth
# ============================================

AUTH_JWT_SECRET_KEY=your-super-secret-key
AUTH_JWT_ALGORITHM=HS256

AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

AUTH_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

AUTH_BCRYPT_ROUNDS=12
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=10

AUTH_FRONTEND_BASE_URL=[http://localhost:3000](http://localhost:3000)


# ============================================
# SMTP
# ============================================

# SMTP
AUTH_SMTP_HOST=localhost
AUTH_SMTP_PORT=1025
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_ADDRESS=no-reply@aurora.local
AUTH_SMTP_USE_TLS=False